# Local scheduler secret. npm run dev/start creates this automatically in .env.
FORECAST_JOB_TOKEN=
# Scale credentials are provisioned from the device settings, for the connected gateway.

# Server-only model settings for the intelligence page. Never use VITE_/NEXT_PUBLIC_ prefixes.
ANALYSIS_API_KEY=
ANALYSIS_BASE_URL=https://api.deepseek.com
ANALYSIS_MODEL=deepseek-flash

# ANALYSIS_KEY_SECRET is generated by npm run dev/start and kept in the ignored .env.
# Preserve it when backing up saved model credentials. Do not put its value in frontend variables.
